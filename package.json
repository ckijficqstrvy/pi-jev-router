{
  "name": "pi-jev-model-router",
  "version": "0.5.0",
  "description": "Route pi prompts to task-appropriate model tiers with TypeSafe Jev typed judgments. Budget-aware, with automatic fallback.",
  "author": {
    "name": "Shah Rukh",
    "email": "shah@da-vinci-noob.com"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "typesafe",
    "jev",
    "system-one",
    "model-router",
    "model-routing",
    "llm-routing",
    "budget"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "esbuild test/thinking.test.ts --bundle --packages=external --platform=node --format=esm --outfile=node_modules/.cache/jev-test.mjs --log-level=warning && node node_modules/.cache/jev-test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckijficqstrvy/pi-jev-router.git"
  },
  "homepage": "https://github.com/ckijficqstrvy/pi-jev-router#readme",
  "bugs": {
    "url": "https://github.com/ckijficqstrvy/pi-jev-router/issues"
  },
  "files": [
    "extensions",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-jev-model-router/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/ckijficqstrvy/pi-jev-router/v0.4.0/assets/decision-entry.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
